# Copy this file to .env and fill in the values before running the tests.
ENV=stage
IS_HEADLESS=FALSE

# Base URL of the application under test (overrides the ENV preset when set).
BASE_URL=

# Base URL of the API (optional, defaults to the application URL).
API_BASE_URL=

# OAuth token endpoint and login used for API authorisation.
AUTH_TOKEN_URL=
AUTH_LOGIN=

# Vault parameters used to fetch test-user credentials at runtime (optional).
VAULT_URL=
VAULT_MOUNT_POINT=
ROLE_VAULT=
SECRET_VAULT=
